{
    "name": "parker-nuxt-lab",
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/archer102125220/parker-nuxt-lab"
    },
    "scripts": {
        "sequelize": "./node_modules/.bin/sequelize",
        "build": "nuxt build",
        "dev": "nuxt dev --host 0.0.0.0",
        "dev-https": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 HTTPS=true nuxt dev -p 3000 --host 0.0.0.0 --https --ssl-cert ./local-ssl/cert.pem --ssl-key ./local-ssl/key.pem",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "analyze": "npx nuxi analyze ",
        "pretest": "yarn build && yarn start",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:integration": "vitest run --config vitest.config.js tests/integration",
        "test:codegen": "playwright codegen http://localhost:3001",
        "test:e2e": "playwright test",
        "test:e2e-ui": "playwright test --ui",
        "test:all": "yarn test:unit && yarn test:integration && yarn pretest && yarn test:e2e",
        "start": "dotenv -e .env -- cross-env NITRO_PORT=3001 node ./.output/server/index.mjs",
        "create-i18n": "babel-node ./i18n/google-sheet-to-json.mjs",
        "initDB": "sequelize db:drop && sequelize db:create && sequelize db:migrate && sequelize db:seed:all",
        "createDB": "sequelize db:create",
        "dropDB": "sequelize db:drop",
        "migrate": "sequelize db:migrate",
        "migrate:undo": "sequelize db:migrate:undo",
        "seed": "sequelize db:seed",
        "seedAll": "sequelize db:seed:all",
        "postinstall": "nuxt prepare"
    },
